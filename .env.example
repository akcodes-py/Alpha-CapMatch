# Settings are read from plain environment variables (no .env loader).
# PowerShell: $env:POSTGRES_PASSWORD="your-password"
# macOS/Linux: export POSTGRES_PASSWORD="your-password"
DJANGO_SECRET_KEY=dev-secret-key-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=recon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional Airtable Bonus (spec section 10)
# Leave empty or omit to disable Airtable syncing.
AIRTABLE_PERSONAL_ACCESS_TOKEN=pat_your_token_here
AIRTABLE_BASE_ID=app_your_base_id_here
AIRTABLE_TABLE_NAME=Needs Review
